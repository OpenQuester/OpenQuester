# Server environment for web end-to-end tests (matches compose.yml).
ENV=dev
API_PORT=53000
API_DOMAIN=localhost
CORS_ORIGINS=*
LOG_LEVEL=warn
DB_TYPE=pg
DB_NAME=oq_web_e2e
DB_USER=oq
DB_PASS=oq
DB_HOST=127.0.0.1
DB_PORT=55432
REDIS_HOST=127.0.0.1
REDIS_PORT=56379
REDIS_DB_NUMBER=0
STORAGE_TYPE=s3
STORAGE_NAME=seaweedfs
S3_ENDPOINT=http://127.0.0.1:58333
S3_BUCKET=oq-web-e2e
S3_ACCESS_KEY=any
S3_SECRET_KEY=any
S3_REGION=us-east-1
S3_USE_SSL=false
S3_PORT=58333
S3_USE_SUB_DOMAIN_BUCKET_FORMAT=false
STARTUP_RECOVERY_ENABLED=true
# The admin e2e test signs in as this dev account (POST /v1/dev/login/990001).
ADMIN_EMAILS=dev@example.com-990001
