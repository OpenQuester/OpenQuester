# Ignore everything by default
*

# Allow only what the Dockerfile needs
!server/
!web/
!openapi/schema.json

# Re-exclude heavy/unnecessary paths inside server/
server/node_modules
server/dist
server/data
server/logs
server/.env
server/.env.*

# …and inside web/
web/node_modules
web/dist
web/test-results
web/playwright-report
web/screenshots
web/.e2e-stack
